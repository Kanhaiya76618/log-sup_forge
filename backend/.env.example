# Copy to .env (gitignored). OWNER: P1. Never commit real keys.

# Server Configuration
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Groq LLM for planner framing + verifier critic (optional)
GROQ_API_KEY=gsk_xxxx

# Live Marine & Weather Telemetry
FLOWFORGE_LIVE=1
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
DISASTER_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# AIS Satellite & Navigation Safety Feeds
AIS_API_KEY=your_aisstream_api_key_here
JAPAN_MSIL_API_KEY=your_japan_msil_api_key_here
JAPAN_SAFETY_INFO_API=https://api.msil.go.jp/safety-information-links/v2/MapServer
JAPAN_NAVIGATION_WARNINGS_API=https://api.msil.go.jp/navigational-warnings/v2/MapServer

# Global News Disruption Feed
NEWS_API_KEY=your_newsapi_key_here
NEWS_FEED_URL=https://newsapi.org/v2/everything
FLOWFORGE_NEWS=1

# Scale live weather thresholds (0.3 = trip on calm days for demos; 1.0 = honest)
DEMO_SENSITIVITY=1.0

# 1 = inject one clearly-labeled synthetic disruption when live weather is calm
FLOWFORGE_FORCE_DEMO=0

# HITL gate: auto-execute only above this confidence and below this cost
AUTO_APPROVE_CONFIDENCE=0.80
MAX_AUTO_COST=5000
