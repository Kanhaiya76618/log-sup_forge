# FlowForge Backend Environment Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ML & Decision Model Thresholds
DISRUPTION_THRESHOLD=0.45
DEFAULT_SPEED_KNOTS=16.0
MAX_SPEED_KNOTS=24.0

# Maritime Financial Rates (USD)
FUEL_PRICE_PER_MT=620.0
HOURLY_VESSEL_COST=1750.0
DEMURRAGE_RATE_PER_DAY=12000.0

# Stochastic Simulation Sample Count
DEFAULT_SIMULATION_SAMPLES=500

# Live AIS Stream Provider (AISStream.io)
AISSTREAM_API_KEY=
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# Weather API Provider
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Relational Database (Optional PostgreSQL/SQLite)
DATABASE_URL=
