# FlowForge Frontend Environment Configuration

# Backend API Endpoint (Dev / Staging / Production)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Live AISStream.io WebSocket Endpoint and API Key
NEXT_PUBLIC_AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
NEXT_PUBLIC_AISSTREAM_API_KEY=

# Default Active Fleet Vessel MMSI for Real-Time Tracking
NEXT_PUBLIC_DEFAULT_MMSI=477265800
